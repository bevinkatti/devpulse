# Local development values only. Replace every value before deployment.
NODE_ENV=development
API_PORT=4000
API_BOOTSTRAP_TOKEN=devpulse-local-bootstrap-only-change-before-use
SIGNING_SECRET_ENCRYPTION_KEY=4444444444444444444444444444444444444444444444444444444444444444
DATABASE_URL=postgres://devpulse:devpulse@localhost:5432/devpulse
KAFKA_BROKERS=localhost:19092
KAFKA_DELIVERY_TOPIC=devpulse.deliveries
KAFKA_SSL=false
# Configure all three only when the broker uses SASL over TLS.
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=replace-me
# KAFKA_SASL_PASSWORD=replace-me
ALLOW_PRIVATE_DESTINATIONS=true
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RESPONSE_LIMIT_BYTES=65536
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
